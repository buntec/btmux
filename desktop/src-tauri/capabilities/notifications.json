{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notifications",
  "description": "allows connected btmux servers to post OS notifications, read the app version, return to the picker, zoom, and set the window background",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "http://\\[\\:\\:1\\]:*"
    ]
  },
  "permissions": [
    "allow-notify",
    "allow-desktop-info",
    "allow-switch-server",
    "allow-zoom",
    "allow-set-background"
  ]
}
