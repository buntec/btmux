{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notifications",
  "description": "allows connected btmux servers to post OS notifications",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "http://\\[\\:\\:1\\]:*"
    ]
  },
  "permissions": [
    "allow-notify"
  ]
}
