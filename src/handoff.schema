// handoff version 12
type Header = { version: number, listener: number, lock: number | null, sessions: Array<SessionSnapshot>, panes: Array<PaneHeader>, telemetry: TelemetryStore, };
type PaneHeader = { id: string, fd: number, pid: number, cols: number, rows: number,
journal: Array<Event>, title: string | null, cwd: string | null, cwd_remote: boolean, spawn_cwd: string | null, color_reports: boolean, colors: Array<[number, number, number] | null>, kitty: KittyKeyboard,
pending: number,
input: number, bin: string | null, shell_name: string | null, };
type Event = { "Data": number } | { "Size": [number, number] };
type KittyKeyboard = {
stacks: [[number, number, number, number, number, number, number, number], [number, number, number, number, number, number, number, number]], alternate: boolean,
modes: [boolean, boolean, boolean], saved: [boolean, boolean, boolean], };
type SessionSnapshot = { id: string, name: string, runtime: Runtime, windows: Array<WindowSnapshot>, active_window: number, };
type WindowSnapshot = { id: string, name: string, panes: Array<PaneSnapshot>, active_pane: number, layout: Layout, zoomed_pane: string | null, };
type PaneSnapshot = { id: string, title: string | null, cwd: string | null, agent_status: AgentStatus,
agent_id: number | null, unread: PaneAlert | null, git: PaneGit | null, };
type PaneGit = {
repo_id: string, repo_name: string, worktree_root: string,
branch: string | null,
main_worktree: boolean, };
type PaneAlert = { level: NotificationLevel, title: string | null, body: string | null, };
type AgentStatus = { state: AgentState, agent: string | null, source: string | null, message: string | null,
background: string | null, };
type AgentState = "unknown" | "idle" | "working" | "blocked" | "done";
type NotificationLevel = "info" | "attention" | "success" | "error";
type Layout = { "type": "leaf", pane_id: string, } | { "type": "v_split", id: string, ratio: number, left: Layout, right: Layout, } | { "type": "h_split", id: string, ratio: number, top: Layout, bottom: Layout, };
type TelemetryStore = { panes: { [key in string]: PaneTelemetry },
closed: Array<string>, };
type PaneTelemetry = { series: Array<ModelSeries>, updated_at: bigint, seen_order: Array<bigint>, };
type ModelSeries = { agent: string, model: string | null, buckets: { [key in bigint]: AgentUsage }, };
type AgentUsage = {
input_tokens: number, output_tokens: number, cached_tokens: number, cache_write_tokens: number,
reasoning_tokens: number, requests: number, tool_calls: number, duration_ms: number, cost_usd: number | null, };
